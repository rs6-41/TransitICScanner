    "NFCReaderUsageDescription" : {
      "comment" : "Privacy - NFC Scan Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read card information."
          }
        },
        "ja" : {
