    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggest cards based on your current location."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の位置に基づいてカードを提案します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据您当前的位置推荐卡片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據您當前的位置推薦卡片"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 기준으로 카드를 추천합니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyarankan kartu berdasarkan lokasi Anda saat ini."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據你目前嘅位置推薦交通卡。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggère des cartes en fonction de votre position actuelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugiere tarjetas según tu ubicación actual."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This information is used to display Google ads.\nAllowing access may help us show you more relevant ads."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google広告の表示に使用されます。許可すると関連性の高い広告が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此信息将用于展示 Google 广告。\n允许后，我们可以为您展示更相关的广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資訊將用於顯示 Google 廣告。\n允許後，我們可以為您顯示更相關的廣告。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 정보는 Google 광고를 표시하는 데 사용됩니다.\n접근을 허용하면 더 관련성 높은 광고를 표시하는 데 도움이 됩니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informasi ini digunakan untuk menampilkan iklan Google.\nMemberikan izin dapat membantu menampilkan iklan yang lebih relevan."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呢啲資料用嚟顯示 Google 廣告。\n允許之後可能會睇到更相關嘅廣告。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces informations servent à afficher des publicités Google.\nAutoriser l’accès peut nous aider à vous proposer des publicités plus pertinentes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta información se usa para mostrar anuncios de Google.\nPermitir el acceso puede ayudarnos a mostrarte anuncios más relevantes."
          }
        }
      }
    }
  },
  "version" : "1.3"
}