    "setting.acknowledgment.jpIC" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kitaca” is a registered trademark of Hokkaido Railway Company.\n\n“Suica” is a registered trademark of East Japan Railway Company.\n\n“PASMO” is a registered trademark of PASMO CO., LTD.\n\n“TOICA” is a registered trademark of Central Japan Railway Company.\n\n“manaca” is a registered trademark of Nagoya Transportation Development Organization and MIC CO., LTD.\n\n“ICOCA” is a registered trademark of West Japan Railway Company.\n\n“SUGOCA” is a registered trademark of Kyushu Railway Company.\n\n“nimoca” is a registered trademark of Nishi-Nippon Railroad Co., Ltd.\n\n“はやかけん” is a registered trademark of Fukuoka City Transportation Bureau.\n\n“PiTaPa” is a registered trademark of Surutto KANSAI Co., Ltd."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Kitaca」は、北海道旅客鉄道株式会社の登録商標です。 \n「Suica」は、東日本旅客鉄道株式会社の登録商標です。 \n「PASMO」は、株式会社パスモの登録商標です。 \n「TOICA」は、東海旅客鉄道株式会社の登録商標です。 \n「manaca」は、株式会社名古屋交通開発機構及び株式会社エムアイシーの登録商標です。 \n「ICOCA」は、西日本旅客鉄道株式会社の登録商標です。 \n「SUGOCA」は、九州旅客鉄道株式会社の登録商標です。 \n「nimoca」は、西日本鉄道株式会社の登録商標です。 \n「はやかけん」は、福岡市交通局の登録商標です。 \n「PiTaPa」は、株式会社スルッとKANSAIの登録商標です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kitaca”是北海道旅客鉄道株式会社的注册商标。\n“Suica”是東日本旅客鉄道株式会社的注册商标。\n“PASMO”是株式会社パスモ的注册商标。\n“TOICA”是東海旅客鉄道株式会社的注册商标。\n“manaca”是株式会社名古屋交通開発機構及株式会社エムアイシー的注册商标。\n“ICOCA”是西日本旅客鉄道株式会社的注册商标。\n“SUGOCA”是九州旅客鉄道株式会社的注册商标。\n“nimoca”是西日本鉄道株式会社的注册商标。\n“はやかけん”是福岡市交通局的注册商标。\n“PiTaPa”是株式会社スルッとKANSAI的注册商标。"
          }
        }
      }
    },
