    "setting.data.cloud.off.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabling cloud sync will prevent scanned cards from being synchronized.\nPreviously synchronized information will not be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドでの同期を無効にすると、スキャンしたカードは同期されなくなります。\n過去に同期した情報は削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用云端同步后，扫描的卡片将不会再进行同步。\n之前已同步的信息不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用雲端同步後，掃描的卡片將不再同步。\n之前已同步的資訊不會被刪除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화를 끄면 읽은 카드가 iCloud에 동기화되지 않습니다.\n이미 동기화된 정보는 삭제되지 않습니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika sinkronisasi iCloud dinonaktifkan, kartu yang dipindai tidak akan disinkronkan.\nInformasi yang sudah disinkronkan tidak akan dihapus."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉 iCloud 同步之後，已讀取嘅卡唔會再同步。\n已經同步嘅資料會保留。"
          }
        }
      }
    },
