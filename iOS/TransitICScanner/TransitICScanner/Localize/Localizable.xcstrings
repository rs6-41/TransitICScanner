    "info.twEasyCard_old.items" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taiwanese EasyCard, EasyCard Co-Branded Card, and Super EasyCard issued in Taiwan are supported. The balance is retrieved from the server.\n\nUnregistered cards: the 10-digit number at the bottom right of the card.\nEasyCard Co-Branded Cards: the 16-digit number at the bottom left on the back of the card.\n\n* Service may be unavailable due to maintenance from around 23:00 to approximately 6:00 (UTC+8)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台湾で発行される悠遊卡、悠遊聯名卡、超級悠遊卡が利用できます。サーバーから残高を取得します。 \n\n無記名カード：カード右下の10桁の数字 \n悠遊聯名カード：カード裏面 左下の16桁の数字 \n※ 現地時間23時〜6時ごろは、メンテナンスにより利用できない場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持在台湾发行的悠遊卡、悠遊聯名卡、超級悠遊卡。余额将从服务器获取。\n\n无记名卡：卡片右下角的10位数字\n悠遊聯名卡：卡片背面左下角的16位数字\n※ 当地时间23:00～6:00左右可能因服务器维护而无法使用。"
          }
        }
      }
    },
