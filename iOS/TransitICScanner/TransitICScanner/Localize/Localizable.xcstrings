    "ads.placeholder.myapp.webp.body" : {
      "comment" : "Ads",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert images to WebP format. Supports transparent PNGs and can help reduce PNG file sizes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像をWebP形式に変換します。透過PNGにも対応し、PNG画像の軽量化を期待できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将图片转换为 WebP 格式。支持透明 PNG，并有助于减小 PNG 文件大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將圖片轉換為 WebP 格式。支援透明 PNG，並有助於減小 PNG 文件大小。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 WebP로 변환합니다. 투명 PNG를 지원하며 파일 크기를 줄일 수 있습니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konversi gambar ke WebP. Mendukung PNG transparan dan dapat memperkecil ukuran berkas."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將圖片轉做 WebP，支援透明 PNG，亦可以縮細 PNG 檔案。"
          }
        }
      }
    },
