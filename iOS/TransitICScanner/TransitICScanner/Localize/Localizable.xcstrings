    "form.description.scraping.easycard" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically enters information into the [official EasyCard website](https://ezweb.easycard.com.tw/search/CardSearch.php) and retrieves the data.\n\nDue to server maintenance, data may not be available between 11:00 PM and 6:00 AM local time.\n\nThis feature may become unavailable if the website's specifications change."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EasyCardの[公式Webサイト](https://ezweb.easycard.com.tw/search/CardSearch.php)に自動で情報を入力し、データを取得します。\n\nサーバーメンテナンスのため、現地時間の23時~6時は取得できない場合があります。\nWebサイトの仕様変更により利用できなくなる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动在悠遊卡的[官方网站](https://ezweb.easycard.com.tw/search/CardSearch.php)中填写信息并获取数据。\n\n由于服务器维护，按照当地时间，23:00～6:00期间可能无法获取数据。\n由于网站规格发生变更，可能会导致该功能无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動在悠遊卡的[官方網站](https://ezweb.easycard.com.tw/search/CardSearch.php)中填寫資訊並取得資料。\n\n由於伺服器維護，按照當地時間，23:00～6:00期間可能無法取得資料。\n由於網站規格發生變更，可能會導致該功能無法使用。"
          }
        }
      }
    },
