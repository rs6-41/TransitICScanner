    "permission.first.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app lets you check and save the balances of IC cards from around the world using your smartphone.\nPlease review the required permissions to personalize your experience."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリでは、世界中のICカード残高をスマートフォンで照会・保存できます。\n体験をパーソナライズするため、必要な権限へのアクセスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用支持使用智能手机查询并保存全球各地 IC 卡的余额。\n为了提供个性化的使用体验，请确认是否授予所需的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用支持使用智能手機查詢並保存全球各地 IC 卡的餘額。 爲了提供個性化的使用體驗，請確認是否授予所需的權限。"
          }
        }
      }
    },
    "permission.gps.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests cards available for use in your current region based on your device’s location."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の位置を参照し、現在位置の地域で利用できるカードを提案します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据设备的位置信息，推荐您所在地区可使用的卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據裝置的位置資訊，推薦您所在區域可使用的卡片。"
          }
        }
      }
    },
    "permission.gps.title" : {
      "localizations" : {
