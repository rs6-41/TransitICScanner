    "permission.att.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We display ads to support the ongoing development and maintenance of this app.\nAllowing tracking helps us show you more relevant ads and measure ad performance.\nPlease tap “Allow” to help us continue maintaining the app.\nThank you for support."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリを開発・運営を継続するために、広告を掲載しています。\nトラッキングを許可すると、あなたに関連性の高い広告の表示や、広告の効果測定に役立てられます。\nアプリの継続的運営のために「許可」をお願いします。\nご協力いただく皆様に感謝いたします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了持续开发和维护这款应用，我们会展示广告。\n允许跟踪有助于我们向您展示更符合您兴趣的广告，并衡量广告效果。\n为了支持应用的持续运营，恳请您选择“允许”。\n谢谢您的合作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 可讓您使用智慧型手機查詢並儲存全球各地 IC 卡的餘額。\n為了提供個人化的使用體驗，請確認是否授予所需的權限。"
          }
        }
      }
    },
    "permission.att.description.ifDenied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don’t allow tracking, you will still see ads, but they may be less relevant to you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しない場合でも、関連性の低い広告が引き続き表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使您不允许跟踪，仍然会看到广告，但这些广告可能与您的兴趣关联较低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使您不允許跟蹤，仍然會看到廣告，但這些廣告可能與您的興趣關聯較低。"
          }
        }
      }
    },
    "permission.att.title" : {
      "localizations" : {
