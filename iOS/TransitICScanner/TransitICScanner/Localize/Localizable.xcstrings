    "setting.acknowledgment.jpNplus" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“エヌタス”, “N+”, and “長崎バス” are trademarks of 長崎自動車株式会社.\n\n“Tカード” is a trademark of カルチュア・コンビニエンス・クラブ株式会社.\n\n“Vポイントカード”, “Vポイント”, and the Vポイント logo are trademarks of V Point Marketing Co., Ltd. and Sumitomo Mitsui Banking Corporation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「エヌタス」、「N+」、「長崎バス」は長崎自動車株式会社の商標です。\n「Tカード」はカルチュア・コンビニエンス・クラブ株式会社の商標です。\n「Vポイントカード」、「Vポイント」、Vポイントロゴは、Vポイントマーケティング株式会社及び三井住友カード株式会社の商標です。"
          }
