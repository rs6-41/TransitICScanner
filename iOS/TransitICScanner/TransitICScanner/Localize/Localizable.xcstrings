    "setting.debug.enable.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developer Mode will remain enabled until the app is restarted.\nIf this was not intentional, tap “Cancel.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを再起動するまで開発者モードを有効にします。\nこの表示が意図したものでない場合、「キャンセル」を押してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在重新启动应用之前，开发者模式将保持启用状态。\n如果此提示不是您有意触发的，请点击“取消”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動 App 前，開發者模式會維持啟用狀態。\n如果此提示不是您有意觸發的，請點擊“取消”。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발자 모드는 앱을 다시 시작할 때까지 활성화됩니다.\n의도하지 않았다면 “취소”를 탭하세요."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode pengembang tetap aktif sampai aplikasi dimulai ulang.\nJika tidak disengaja, ketuk “Batal”."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開發者模式會維持啟用，直到重新開啟 App。\n如果唔係有意開啟，請撳「取消」。"
          }
        }
      }
    },
