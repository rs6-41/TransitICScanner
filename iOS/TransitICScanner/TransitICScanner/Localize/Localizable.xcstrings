    "error.storage.inMemory.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved data could not be opened. Cards scanned now will not be kept after the app is closed. Please restart the app or update to the latest version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存データを開けませんでした。今スキャンしたカードはアプリを終了すると保存されません。アプリを再起動するか、最新版にアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开已保存的数据。现在扫描的卡片在关闭应用后不会被保存。请重新启动应用或更新到最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟已儲存的資料。現在掃描的卡片在關閉App後不會被保存。請重新啟動App或更新至最新版本。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 데이터를 열 수 없습니다. 지금 읽는 카드는 앱을 닫으면 보관되지 않습니다. 앱을 다시 시작하거나 최신 버전으로 업데이트하세요."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data tersimpan tidak dapat dibuka. Kartu yang dipindai sekarang tidak akan disimpan setelah aplikasi ditutup. Mulai ulang aplikasi atau perbarui ke versi terbaru."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開唔到已儲存嘅資料。依家讀到嘅卡喺關閉 App 後唔會保留。請重新開啟 App 或更新到最新版。"
          }
        }
      }
    },
    "error.storage.localOnly.message" : {
