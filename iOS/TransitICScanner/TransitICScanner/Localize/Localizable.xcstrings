    "setting.feature.card.description.devMode" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If card types are selected in the development settings, this setting cannot be changed.\nTo test the “Beta Features” screen, go to Setting > Debug > Display Card Types, select “Unselected.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発設定で表示カード種別を選択している場合、この設定は変更できません。\n「試験的な機能」画面をテストする場合、設定 > デバッグ > 表示カード種別 から、「未選択」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前已在开发设置中指定了显示卡片类型，因此无法直接修改该设置。\n如需测试“实验性功能”页面，请前往“设置 > 调试 > 显示卡片类型”，将选项更改为“未选择”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前已在開發設定中指定了顯示卡片類型，因此無法直接修改該設定。\n如需測試「實驗性功能」頁面，請前往設定 > 偵錯 > 顯示卡片類型，將選項更改為「未選擇」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발 설정에서 카드 유형을 선택한 경우 이 설정을 변경할 수 없습니다.\n“베타 기능”을 테스트하려면 설정 > 디버그 > 카드 유형 표시에서 “선택 안 함”을 선택하세요."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan ini tidak dapat diubah jika jenis kartu dipilih di pengaturan pengembangan.\nUntuk menguji “Fitur beta”, buka Pengaturan > Debug > Tampilkan jenis kartu, lalu pilih “Tidak dipilih”."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果喺開發設定揀咗卡類型，就改唔到呢個設定。\n要測試「Beta 功能」，請去設定 > 除錯 > 顯示卡類型，再揀「未揀選」。"
          }
        }
      }
    },
    "setting.feature.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental features are currently under development and may contain bugs or other issues.\nFeatures may be removed or changed without prior notice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試験的な機能は開発中のものであり、不具合が発生する場合があります。\n機能は予告なく削除・変更される可能性があります。"
          }
        },
        "zh-Hans" : {
