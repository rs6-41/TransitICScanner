    "form.birthday.description" : {
      "comment" : "Scraping Form\nスクレイピングフォーム",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For registered cards, enter your date of birth as two-digit numbers. (Not required for unregistered cards.)"
