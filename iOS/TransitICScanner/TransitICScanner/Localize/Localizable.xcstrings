    "cardList.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The respective brands have no partnership, affiliation, or authorization relationship with this app.\nScan results are for reference only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ブランドは本アプリの提携・承認関係にありません。\nスキャン結果は参考用です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品牌与本应用不存在合作或授权关系。\n扫描结果仅供参考。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品牌與本APP不存在合作或授權關係。\n掃描結果僅供參考。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 브랜드는 이 앱과 제휴, 소속 또는 승인 관계가 없습니다.\n읽기 결과는 참고용입니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merek terkait tidak bermitra dengan, terafiliasi dengan, atau mengesahkan aplikasi ini.\nHasil pembacaan hanya untuk referensi."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品牌同本 App 並無合作、從屬或者授權關係。\n讀卡結果只供參考。"
          }
        }
      }
    },
    "cardList.error.nfc" : {
      "comment" : "外部（CCID）カードリーダーが未接続のままスキャンしようとしたときのエラー。iPhone内蔵NFCの状態ではない。\n表記統一: ja「外部リーダー」/ zh-Hans「外接读卡器」/ zh-Hant「外接讀卡機」、内蔵は「内蔵／内置／內建」。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card reader disconnected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードリーダーが接続されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读卡器未连接"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀卡機未連線"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 리더 연결이 끊겼습니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaca kartu terputus."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀卡器已中斷連線。"
          }
        }
      }
    },
    "cardList.external.description" : {
      "comment" : "iPhone内蔵NFCでは読めず、外部リーダー専用のカードに表示する説明。\n表記統一: ja「外部リーダー」/ zh-Hans「外接读卡器」/ zh-Hant「外接讀卡機」、内蔵は「内蔵／内置／內建」。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect an external reader to scan this card.\nDue to hardware limitations, this cannot be read on an iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部リーダーを接続して、このカードをスキャンします。\nハードウェアの制約によりiPhoneでは読み取れません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接外接读卡器以扫描此卡片。\n受硬件限制，iPhone 无法直接读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請連接外接讀卡機以掃描此卡片。\n受限於硬體規格，無法使用 iPhone 讀取。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 카드를 읽으려면 외장 리더를 연결하세요.\n하드웨어 제한으로 iPhone에서 직접 읽을 수 없습니다."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan pembaca eksternal untuk memindai kartu ini.\nKarena keterbatasan perangkat keras, kartu ini tidak dapat dibaca langsung di iPhone."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請連接外置讀卡器讀呢張卡。\n受硬件限制，iPhone 無法直接讀取。"
          }
        }
      }
    },
