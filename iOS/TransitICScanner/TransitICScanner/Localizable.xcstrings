      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taiwanese EasyCard, EasyCard Co-Branded Card, and Super EasyCard issued in Taiwan are supported. The balance is retrieved from the server.\n\nUnregistered cards: the 10-digit number at the bottom right of the card.\nEasyCard Co-Branded Cards: the 16-digit number at the bottom left on the back of the card.\n\n* Service may be unavailable due to maintenance from around midnight to approximately 6:00 AM."
